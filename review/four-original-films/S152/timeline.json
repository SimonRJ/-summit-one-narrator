  "captions": [
    {
      "start": 0.6,
      "end": 2.8499999999999996,
      "text": "Two trays hold twenty counters altogether."
    },
    {
      "start": 3.62,
      "end": 5.89,
      "text": "Move three counters from the left tray to the right."
    },
    {
      "start": 6.34,
      "end": 7.51,
      "text": "The total stays twenty."
    },
    {
      "start": 8.14,
      "end": 11.99,
      "text": "Watch the gap: one side loses three at the same moment"
    },
    {
      "start": 12.16,
      "end": 13.57,
      "text": "the other side gains three."
    },
    {
      "start": 14.36,
      "end": 16.909999999999997,
      "text": "Start with twelve on the left and eight on the right."
    },
    {
      "start": 17.2,
      "end": 17.89,
      "text": "Move one across."
    },
    {
      "start": 18.46,
      "end": 20.169999999999998,
      "text": "The counts become eleven and nine."
    },
    {
      "start": 20.48,
      "end": 22.49,
      "text": "The difference shrinks from four to two."
    },
    {
      "start": 23.1,
      "end": 25.45,
      "text": "A single transfer changed the gap by two."
    },
    {
      "start": 26.36,
      "end": 28.729999999999997,
      "text": "Two storage cases hold forty eight badges."
    },
    {
      "start": 29.46,
      "end": 32.03,
      "text": "After six badges move from the fuller case to the other,"
    },
    {
      "start": 32.34,
      "end": 34.01,
      "text": "the cases contain equal numbers."
    },
    {
      "start": 34.66,
      "end": 37.25000000000001,
      "text": "How many badges were in each case before the move?"
    },
    {
      "start": 41.05,
      "end": 44.080000000000005,
      "text": "Equal shares of forty eight are twenty four each."
    },
    {
      "start": 44.589999999999996,
      "end": 47.669999999999995,
      "text": "Put the six badges back into the fuller case and remove"
    },
    {
      "start": 47.669999999999995,
      "end": 48.64,
      "text": "them from the other."
    },
    {
      "start": 49.15,
      "end": 51.50000000000001,
      "text": "Thirty and eighteen are the original counts."
    },
    {
      "start": 52.11,
      "end": 55.18,
      "text": "Their difference is twelve, exactly twice the transfer."
    },
    {
      "start": 56.25,
      "end": 58.660000000000004,
      "text": "Three trays contain thirty six counters."
    },
    {
      "start": 59.27,
      "end": 61.86,
      "text": "The first tray gives half its counters to the second."
    },
    {
      "start": 62.51,
      "end": 64.77000000000001,
      "text": "Then the second gives one third of its new pile"
    },
    {
      "start": 64.77000000000001,
      "end": 65.52,
      "text": "to the third."
    },
    {
      "start": 66.05,
      "end": 67.17999999999999,
      "text": "All three finish equal."
    },
    {
      "start": 67.61,
      "end": 69.46,
      "text": "How many counters started in the first,"
    },
    {
      "start": 69.63,
      "end": 70.98,
      "text": "second and third trays?"
    },
    {
      "start": 74.78,
      "end": 76.80999999999999,
      "text": "Finish with twelve in every tray."
    },
    {
      "start": 77.18,
      "end": 79.50999999999999,
      "text": "The second tray kept two thirds of its pile."
    },
    {
      "start": 79.94,
      "end": 83.11,
      "text": "Those two thirds are twelve, so each third is six."
    },
    {
      "start": 83.56,
      "end": 86.61,
      "text": "Just before that transfer the second tray held eighteen,"
    },
    {
      "start": 86.98,
      "end": 88.67,
      "text": "and the third held only six."
    },
    {
      "start": 89.26,
      "end": 90.83,
      "text": "The first still held twelve."
    },
    {
      "start": 91.74,
      "end": 94.61,
      "text": "The first tray kept half and ended with twelve."
    },
    {
      "start": 95.17999999999999,
      "end": 98.06,
      "text": "It must have started with twenty four and passed twelve"
    },
    {
      "start": 98.06,
      "end": 98.78999999999999,
      "text": "to the second."
    },
    {
      "start": 99.38,
      "end": 100.82999999999998,
      "text": "Remove those twelve from eighteen."
    },
    {
      "start": 101.8,
      "end": 104.77,
      "text": "The starting counts were twenty four, six and six."
    },
    {
      "start": 105.39999999999999,
      "end": 107.44999999999999,
      "text": "Run both transfers forwards to check."
    },
    {
      "start": 108.38,
      "end": 110.32999999999998,
      "text": "The words its new pile matter."
    },
    {
      "start": 110.61999999999999,
      "end": 113.03,
      "text": "A fraction acts on the contents at that moment."
    },
    {
      "start": 113.52,
      "end": 115.94999999999999,
      "text": "Mark the total, record who gives and receives,"
    },
    {
      "start": 116.46,
      "end": 119.34,
      "text": "and run transfers backwards one at a time when the final"
    },
    {
      "start": 119.34,
      "end": 120.26999999999998,
      "text": "amounts are known."
    }
  ]
}
