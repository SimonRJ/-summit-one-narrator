  "captions": [
    {
      "start": 0.6,
      "end": 3.93,
      "text": "A four digit odometer reads three, four, four, three."
    },
    {
      "start": 4.34,
      "end": 5.369999999999999,
      "text": "It is a palindrome."
    },
    {
      "start": 5.9399999999999995,
      "end": 8.03,
      "text": "Imagine putting a mirror between the middle wheels."
    },
    {
      "start": 8.4,
      "end": 9.92,
      "text": "Which wheels can you choose freely,"
    },
    {
      "start": 9.92,
      "end": 11.77,
      "text": "and which are already determined?"
    },
    {
      "start": 12.92,
      "end": 14.670000000000002,
      "text": "The first two wheels show thirty four."
    },
    {
      "start": 15.620000000000001,
      "end": 17.32,
      "text": "Reflect them in reverse order to make thirty"
    },
    {
      "start": 17.32,
      "end": 18.709999999999997,
      "text": "four, forty three."
    },
    {
      "start": 19.5,
      "end": 22.51,
      "text": "Advancing the first pair to thirty five produces three,"
    },
    {
      "start": 23.08,
      "end": 24.11,
      "text": "five, five, three."
    },
    {
      "start": 24.5,
      "end": 26.73,
      "text": "The palindromes are a hundred and ten apart."
    },
    {
      "start": 27.8,
      "end": 31.349999999999998,
      "text": "Now the odometer shows three, nine, nine, three."
    },
    {
      "start": 32.0,
      "end": 33.13,
      "text": "Predict the next palindrome."
    },
    {
      "start": 33.56,
      "end": 35.61000000000001,
      "text": "Be careful when the nine rolls back to zero."
    },
    {
      "start": 39.46,
      "end": 41.81,
      "text": "The next possible first pair is forty."
    },
    {
      "start": 42.46,
      "end": 46.160000000000004,
      "text": "Its reflection is zero four, so the new reading is four"
    },
    {
      "start": 46.160000000000004,
      "end": 47.27,
      "text": "thousand and four."
    },
    {
      "start": 47.92,
      "end": 49.99000000000001,
      "text": "Subtract three thousand nine hundred and ninety three."
    },
    {
      "start": 51.260000000000005,
      "end": 53.03,
      "text": "This time the gap is just eleven."
    },
    {
      "start": 53.86,
      "end": 56.083999999999996,
      "text": "From one thousand and one through nine thousand nine"
    },
    {
      "start": 56.083999999999996,
      "end": 59.46,
      "text": "hundred and ninety nine, how many whole numbers lie"
    },
    {
      "start": 59.46,
      "end": 61.86,
      "text": "exactly halfway between two consecutive"
    },
    {
      "start": 61.86,
      "end": 64.08,
      "text": "four digit palindromes?"
    },
    {
      "start": 64.08,
      "end": 66.46999999999998,
      "text": "Count the gaps, without listing every address."
    },
    {
      "start": 70.31,
      "end": 71.97999999999999,
      "text": "Hold the thousands wheel fixed."
    },
    {
      "start": 72.65,
      "end": 74.8,
      "text": "The hundreds wheel runs from zero to nine."
    },
    {
      "start": 75.13,
      "end": 77.58,
      "text": "Ten palindromes make nine gaps of one hundred and ten."
    },
    {
      "start": 78.67,
      "end": 80.77000000000001,
      "text": "Each even gap has one whole number exactly"
    },
    {
      "start": 80.77000000000001,
      "end": 81.77999999999999,
      "text": "in its middle."
    },
    {
      "start": 82.21000000000001,
      "end": 84.7,
      "text": "There are nine possible nonzero thousands digits."
    },
    {
      "start": 85.83,
      "end": 88.88,
      "text": "Nine groups of nine give eighty one halfway addresses."
    },
    {
      "start": 89.59,
      "end": 91.75,
      "text": "The eight carries between the groups each make a"
    },
    {
      "start": 91.75,
      "end": 92.49999999999999,
      "text": "gap of eleven."
    },
    {
      "start": 93.19,
      "end": 95.16,
      "text": "Half of eleven is not a whole number,"
    },
    {
      "start": 95.50999999999999,
      "end": 97.13,
      "text": "so those carries contribute none."
    },
    {
      "start": 97.13,
      "end": 100.66,
      "text": "Eighty one large gaps and eight small ones give eighty"
    },
    {
      "start": 100.66,
      "end": 103.17999999999999,
      "text": "nine gaps among ninety palindromes."
    },
    {
      "start": 103.91,
      "end": 107.25999999999999,
      "text": "A mirror makes the last two digits follow the first two."
    },
    {
      "start": 107.71,
      "end": 110.83,
      "text": "To find the next palindrome, increase the first pair and"
    },
    {
      "start": 110.83,
      "end": 111.71999999999998,
      "text": "reflect it again."
    },
    {
      "start": 112.22999999999999,
      "end": 114.65,
      "text": "When counting a pattern, test the change at a carry"
    },
    {
      "start": 114.65,
      "end": 116.83999999999999,
      "text": "before assuming every step is equal."
    }
  ]
}
