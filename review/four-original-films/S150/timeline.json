  "captions": [
    {
      "start": 0.6,
      "end": 2.17,
      "text": "Five discs feel identical."
    },
    {
      "start": 2.8400000000000003,
      "end": 5.01,
      "text": "Two show a sun and three show a moon."
    },
    {
      "start": 5.64,
      "end": 7.21,
      "text": "Mix them and draw without looking."
    },
    {
      "start": 7.64,
      "end": 9.21,
      "text": "Each disc is equally likely."
    },
    {
      "start": 9.92,
      "end": 12.09,
      "text": "Leave the first disc out when you draw the next one."
    },
    {
      "start": 12.44,
      "end": 13.790000000000001,
      "text": "How does that change your chances?"
    },
    {
      "start": 15.0,
      "end": 18.169999999999998,
      "text": "The first disc is a sun with probability two fifths."
    },
    {
      "start": 18.62,
      "end": 21.38,
      "text": "After that sun comes out, only one sun remains"
    },
    {
      "start": 21.38,
      "end": 22.509999999999998,
      "text": "among four discs."
    },
    {
      "start": 23.46,
      "end": 26.37,
      "text": "The chance of two suns is two fifths times one quarter."
    },
    {
      "start": 27.02,
      "end": 27.830000000000002,
      "text": "That is one tenth."
    },
    {
      "start": 28.76,
      "end": 31.750000000000004,
      "text": "Now try for one sun and one moon in either order."
    },
    {
      "start": 32.260000000000005,
      "end": 34.660000000000004,
      "text": "If a sun comes first, three of the four discs"
    },
    {
      "start": 34.660000000000004,
      "end": 35.63,
      "text": "left are moons."
    },
    {
      "start": 36.620000000000005,
      "end": 39.2,
      "text": "If a moon comes first, how many of the four discs"
    },
    {
      "start": 39.2,
      "end": 40.53000000000001,
      "text": "left are suns?"
    },
    {
      "start": 44.25,
      "end": 45.96,
      "text": "Two suns remain after a moon."
    },
    {
      "start": 46.55,
      "end": 49.11,
      "text": "Sun then moon has probability two fifths"
    },
    {
      "start": 49.11,
      "end": 50.220000000000006,
      "text": "times three quarters."
    },
    {
      "start": 50.85,
      "end": 53.47,
      "text": "Moon then sun has probability three fifths"
    },
    {
      "start": 53.47,
      "end": 54.480000000000004,
      "text": "times two quarters."
    },
    {
      "start": 55.19,
      "end": 57.47,
      "text": "Each order contributes six twentieths."
    },
    {
      "start": 57.47,
      "end": 60.56000000000001,
      "text": "They cannot happen together on one draw of two discs,"
    },
    {
      "start": 60.91,
      "end": 61.6,
      "text": "so add them."
    },
    {
      "start": 62.269999999999996,
      "end": 64.62,
      "text": "Twelve twentieths simplifies to three fifths."
    },
    {
      "start": 65.53,
      "end": 68.11999999999999,
      "text": "The machine now draws two discs in secret."
    },
    {
      "start": 68.79,
      "end": 71.67999999999999,
      "text": "A lamp lights exactly when at least one sun appears."
    },
    {
      "start": 72.01,
      "end": 73.1,
      "text": "You see the lamp light."
    },
    {
      "start": 73.83,
      "end": 76.44,
      "text": "What is the chance that both discs show suns?"
    },
    {
      "start": 76.73,
      "end": 79.12,
      "text": "The lamp never tells you which disc came first."
    },
    {
      "start": 82.94,
      "end": 85.46,
      "text": "Label the five discs so we can tell every"
    },
    {
      "start": 85.46,
      "end": 86.50999999999999,
      "text": "ordered pair apart."
    },
    {
      "start": 87.28,
      "end": 89.98,
      "text": "Five choices for the first disc, then four for the"
    },
    {
      "start": 89.98,
      "end": 92.72999999999999,
      "text": "second, make twenty equally likely pairs."
    },
    {
      "start": 93.53999999999999,
      "end": 95.77,
      "text": "The lamp stays dark only for two moons."
    },
    {
      "start": 96.46,
      "end": 99.30999999999999,
      "text": "Three choices followed by two give six dark pairs."
    },
    {
      "start": 99.92,
      "end": 102.07,
      "text": "Fourteen pairs are left when the lamp lights."
    },
    {
      "start": 103.1,
      "end": 106.69999999999999,
      "text": "Only two of those fourteen pairs use both suns."
    },
    {
      "start": 106.69999999999999,
      "end": 107.94999999999999,
      "text": "Either sun can come first."
    },
    {
      "start": 108.61999999999999,
      "end": 110.36999999999999,
      "text": "Two out of fourteen is one seventh."
    },
    {
      "start": 110.96,
      "end": 114.19999999999999,
      "text": "Keep the remaining discs up to date on each draw."
    },
    {
      "start": 114.19999999999999,
      "end": 116.13,
      "text": "When a competition question gives you a clue,"
    },
    {
      "start": 116.5,
      "end": 118.92999999999999,
      "text": "keep only the outcomes that could have produced it."
    }
  ]
}
