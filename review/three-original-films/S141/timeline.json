  "captions": [
    {
      "start": 0.6,
      "end": 2.33,
      "text": "These creek readings look dramatic."
    },
    {
      "start": 2.88,
      "end": 5.51,
      "text": "One blue bar seems twice as tall as the other."
    },
    {
      "start": 6.18,
      "end": 8.55,
      "text": "Before deciding that the water is twice as deep,"
    },
    {
      "start": 8.82,
      "end": 10.67,
      "text": "read the number at the bottom of the scale."
    },
    {
      "start": 11.64,
      "end": 13.850000000000003,
      "text": "The axis starts at thirty centimetres."
    },
    {
      "start": 14.72,
      "end": 17.86,
      "text": "The water was thirty six centimetres deep on Monday and"
    },
    {
      "start": 17.86,
      "end": 19.21,
      "text": "forty two on Tuesday."
    },
    {
      "start": 19.82,
      "end": 21.35,
      "text": "The rise is six centimetres."
    },
    {
      "start": 22.200000000000003,
      "end": 25.22,
      "text": "Restoring the missing thirty shows why twice the visible"
    },
    {
      "start": 25.22,
      "end": 28.23,
      "text": "height is only seven sixths of the original depth."
    },
    {
      "start": 29.24,
      "end": 31.389999999999997,
      "text": "Two tanks are shown on a second chart."
    },
    {
      "start": 31.979999999999997,
      "end": 34.379999999999995,
      "text": "The bottom line means twelve litres."
    },
    {
      "start": 34.379999999999995,
      "end": 36.76,
      "text": "Every interval adds two litres."
    },
    {
      "start": 36.76,
      "end": 39.87,
      "text": "One bar rises three intervals and the other rises seven."
    },
    {
      "start": 40.14,
      "end": 42.79,
      "text": "What is the ratio of the fuller tank to the other?"
    },
    {
      "start": 46.49,
      "end": 49.29,
      "text": "Three intervals add six litres, so the smaller"
    },
    {
      "start": 49.29,
      "end": 50.580000000000005,
      "text": "tank contains eighteen."
    },
    {
      "start": 51.29,
      "end": 54.550000000000004,
      "text": "Seven intervals add fourteen litres, so the larger one"
    },
    {
      "start": 54.550000000000004,
      "end": 55.480000000000004,
      "text": "contains twenty six."
    },
    {
      "start": 56.290000000000006,
      "end": 59.660000000000004,
      "text": "Twenty six to eighteen simplifies to thirteen to nine."
    },
    {
      "start": 60.13,
      "end": 62.64000000000001,
      "text": "Seven to three compares the visible pieces alone."
    },
    {
      "start": 63.61,
      "end": 65.48,
      "text": "The bottom label has rubbed off a chart."
    },
    {
      "start": 65.95,
      "end": 68.69999999999999,
      "text": "The values at the tops are thirty six and forty eight."
    },
    {
      "start": 69.45,
      "end": 72.21000000000001,
      "text": "The longer bar looks exactly three times as tall as"
    },
    {
      "start": 72.21000000000001,
      "end": 73.03999999999999,
      "text": "the shorter bar."
    },
    {
      "start": 73.53,
      "end": 75.1,
      "text": "What number was on the bottom line?"
    },
    {
      "start": 78.78,
      "end": 81.49,
      "text": "Imagine sliding the short bar beside the long one."
    },
    {
      "start": 81.84,
      "end": 83.44999999999999,
      "text": "Their tops are twelve units apart."
    },
    {
      "start": 84.16,
      "end": 86.98,
      "text": "That gap is two short bars, because the long bar"
    },
    {
      "start": 86.98,
      "end": 88.25,
      "text": "contains three of them."
    },
    {
      "start": 88.66,
      "end": 91.27,
      "text": "Each short bar therefore represents six units."
    },
    {
      "start": 92.22,
      "end": 94.16999999999999,
      "text": "The shorter bar ends at thirty six."
    },
    {
      "start": 94.84,
      "end": 97.99,
      "text": "Step down six and the erased label must be thirty."
    },
    {
      "start": 98.62,
      "end": 99.44999999999999,
      "text": "Check the long bar."
    },
    {
      "start": 100.14,
      "end": 101.86,
