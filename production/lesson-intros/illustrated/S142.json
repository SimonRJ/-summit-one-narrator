first.","start":160.48,"end":160.88,"matched":true},{"text":"The","start":161.7,"end":161.74,"matched":true},{"text":"denominator","start":161.74,"end":162.38,"matched":true},{"text":"names","start":162.38,"end":162.56,"matched":true},{"text":"the","start":162.56,"end":162.88,"matched":true},{"text":"size","start":162.88,"end":163.12,"matched":true},{"text":"of","start":163.12,"end":163.38,"matched":true},{"text":"the","start":163.38,"end":163.52,"matched":true},{"text":"full","start":163.52,"end":163.72,"matched":true},{"text":"set","start":163.72,"end":164.02,"matched":true},{"text":"of","start":164.02,"end":164.16,"matched":true},{"text":"parts.","start":164.16,"end":164.42,"matched":true}],"match":100.0},{"n":11,"start":165.64,"end":183.133333,"speech_end":177.64,"words":[{"text":"Write","start":165.64,"end":165.88,"matched":true},{"text":"the","start":165.88,"end":166.06,"matched":true},{"text":"word","start":166.06,"end":166.26,"matched":true},{"text":"original,","start":166.26,"end":166.52,"matched":true},{"text":"remaining","start":167.04,"end":167.24,"matched":true},{"text":"or","start":167.24,"end":167.66,"matched":true},{"text":"new","start":167.66,"end":167.88,"matched":true},{"text":"above","start":167.88,"end":168.12,"matched":true},{"text":"each","start":168.12,"end":168.34,"matched":true},{"text":"fraction.","start":168.34,"end":168.6,"matched":true},{"text":"Draw","start":169.48,"end":169.54,"matched":true},{"text":"equal","start":169.54,"end":169.82,"matched":true},{"text":"parts","start":169.82,"end":170.22,"matched":true},{"text":"for","start":170.22,"end":170.5,"matched":true},{"text":"that","start":170.5,"end":170.64,"matched":true},{"text":"named","start":170.64,"end":170.9,"matched":true},{"text":"whole.","start":170.9,"end":171.16,"matched":true},{"text":"If","start":171.84,"end":171.88,"matched":true},{"text":"the","start":171.88,"end":172.02,"matched":true},{"text":"ending","start":172.02,"end":172.22,"matched":true},{"text":"is","start":172.22,"end":172.46,"matched":true},{"text":"known,","start":172.46,"end":172.74,"matched":true},{"text":"rebuild","start":173.18,"end":173.36,"matched":true},{"text":"the","start":173.36,"end":173.7,"matched":true},{"text":"last","start":173.7,"end":173.92,"matched":true},{"text":"whole","start":173.92,"end":174.26,"matched":true},{"text":"first.","start":174.26,"end":174.58,"matched":true},{"text":"Then","start":175.32,"end":175.42,"matched":true},{"text":"reverse","start":175.42,"end":175.66,"matched":true},{"text":"any","start":175.66,"end":176.1,"matched":true},{"text":"addition","start":176.1,"end":176.54,"matched":true},{"text":"and","start":176.54,"end":176.88,"matched":true},{"text":"earlier","start":176.88,"end":177.16,"matched":true},{"text":"removal.","start":177.16,"end":177.64,"matched":true}],"match":100.0}],"captions":[{"start":0.0,"end":3.42,"text":"A fraction tells you about a particular whole."},{"start":3.42,"end":6.52,"text":"When the whole changes, the same fraction can describe a"},{"start":6.52,"end":7.75,"text":"different number of pieces."},{"start":8.62,"end":11.64,"text":"Draw equal parts for the first whole, then mark which"},{"start":11.64,"end":14.05,"text":"amount becomes the whole for the next instruction."},{"start":15.0,"end":18.72,"text":"In AMC practice, a fraction of the original pile and a"},{"start":18.72,"end":21.51,"text":"fraction of what is left can occur in the same problem."},{"start":21.98,"end":23.71,"text":"Underline the words after of."},{"start":24.3,"end":27.5,"text":"A Rossmoyne style word puzzle may reveal the ending and"},{"start":27.5,"end":29.93,"text":"ask you to recover the starting quantity."},{"start":30.66,"end":32.13,"text":"Reverse one change at a time."},{"start":32.92,"end":34.09,"text":"There are twenty-four tokens."},{"start":34.4,"end":36.37,"text":"A player takes one of four equal parts."},{"start":36.8,"end":37.89,"text":"How many tokens remain?"},{"start":38.64,"end":40.96,"text":"Show the difference between the amount removed and the"},{"start":40.96,"end":42.65,"text":"amount the question asks for."},{"start":46.17,"end":47.78,"text":"One part has six tokens."},{"start":48.49,"end":51.18,"text":"The remaining three parts contain eighteen tokens."},{"start":51.75,"end":53.74,"text":"Check by adding the removed part back."},{"start":54.15,"end":56.48,"text":"eighteen plus six returns twenty-four."},{"start":57.38,"end":60.05,"text":"A box starts with seventy-two chalk pieces."},{"start":60.8,"end":63.15,"text":"A class uses one of four equal parts."},{"start":63.84,"end":66.48,"text":"Then another class uses one of three equal parts of"},{"start":66.48,"end":67.13,"text":"what is left."},{"start":67.92,"end":70.23,"text":"How many pieces remain after both classes?"},{"start":70.8,"end":72.23,"text":"Label the whole for each fraction."},{"start":76.07,"end":79.02,"text":"After the first class the remaining count is fifty-four,"},{"start":79.63,"end":82.14,"text":"since seventy-two divided by four were used."},{"start":82.59,"end":84.04,"text":"The next whole is now fifty-four."},{"start":84.71,"end":86.54,"text":"Divide it into three equal parts."},{"start":87.57,"end":89.8,"text":"The second class uses eighteen pieces."},{"start":90.25,"end":92.26,"text":"Subtract the second use to get thirty-six."},{"start":92.75,"end":95.1,"text":"This is two of the second whole's parts."},{"start":96.07,"end":98.64,"text":"Take one of four equal parts from a pile."},{"start":99.27,"end":100.5,"text":"Add a gift of nine pieces."},{"start":101.11,"end":103.68,"text":"Then take one of three equal parts of that new amount."},{"start":104.39,"end":106.12,"text":"There are forty-two pieces left."},{"start":106.55,"end":108.24,"text":"How many were in the original pile?"},{"start":112.04,"end":115.26,"text":"The ending forty-two pieces represent two of the last"},{"start":115.26,"end":116.45,"text":"three equal parts."},{"start":116.92,"end":119.76,"text":"Find one part, then rebuild that whole."},{"start":119.76,"end":121.67,"text":"Undo the gift by subtracting nine."},{"start":122.36,"end":124.92,"text":"The remaining fifty-four pieces are what was left after"},{"start":124.92,"end":125.75,"text":"the first removal."},{"start":126.44,"end":128.85,"text":"Those were three of the original four equal parts."},{"start":129.62,"end":131.67,"text":"Restoring the missing part gives seventy-two."},{"start":133.0,"end":134.11,"text":"Run the recipe forward."},{"start":134.62,"end":137.09,"text":"Remove eighteen from seventy-two to get fifty-four."},{"start":137.76,"end":139.21,"text":"Add the gift to get sixty-three."},{"start":139.84,"end":141.35,"text":"The final removal is twenty-one."},{"start":142.02,"end":144.23,"text":"That leaves forty-two, the stated ending."},{"start":144.68,"end":147.88,"text":"Each fraction has used its own whole."},{"start":147.88,"end":151.0,"text":"Add fractions directly only when they refer to the"},{"start":151.0,"end":152.33,"text":"same original whole."},{"start":152.92,"end":155.55,"text":"A fraction of what is left uses a new whole."},{"start":156.04,"end":159.14,"text":"When reversing a removal, divide the remaining amount by"},{"start":159.14,"end":161.01,"text":"the number of remaining parts first."},{"start":161.7,"end":164.55,"text":"The denominator names the size of the full set of parts."},{"start":165.64,"end":167.88,"text":"Write the word original, remaining or new"},{"start":167.88,"end":168.73,"text":"above each fraction."},{"start":169.48,"end":171.29,"text":"Draw equal parts for that named whole."},{"start":171.84,"end":174.71,"text":"If the ending is known, rebuild the last whole first."},{"start":175.32,"end":177.77,"text":"Then reverse any addition and earlier removal."}]}
