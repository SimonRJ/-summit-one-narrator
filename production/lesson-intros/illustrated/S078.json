ed":true},{"text":"one","start":152.98,"end":153.06,"matched":true},{"text":"subtraction","start":153.06,"end":153.5,"matched":true},{"text":"removes","start":153.5,"end":153.98,"matched":true},{"text":"the","start":153.98,"end":154.28,"matched":true},{"text":"overlap","start":154.28,"end":154.52,"matched":true},{"text":"again.","start":154.52,"end":154.96,"matched":true},{"text":"Add","start":155.62,"end":155.68,"matched":true},{"text":"that","start":155.68,"end":155.84,"matched":true},{"text":"common","start":155.84,"end":156.12,"matched":true},{"text":"area","start":156.12,"end":156.44,"matched":true},{"text":"back","start":156.44,"end":156.72,"matched":true},{"text":"once.","start":156.72,"end":157.0,"matched":true}],"match":100.0},{"n":11,"start":158.12,"end":175.933333,"speech_end":170.6,"words":[{"text":"Draw","start":158.12,"end":158.4,"matched":true},{"text":"the","start":158.4,"end":158.56,"matched":true},{"text":"full","start":158.56,"end":158.76,"matched":true},{"text":"surrounding","start":158.76,"end":159.14,"matched":true},{"text":"shape.","start":159.14,"end":159.68,"matched":true},{"text":"Name","start":160.24,"end":160.44,"matched":true},{"text":"each","start":160.44,"end":160.64,"matched":true},{"text":"piece","start":160.64,"end":161.0,"matched":true},{"text":"you","start":161.0,"end":161.2,"matched":true},{"text":"add","start":161.2,"end":161.44,"matched":true},{"text":"or","start":161.44,"end":161.68,"matched":true},{"text":"subtract,","start":161.68,"end":162.0,"matched":true},{"text":"and","start":162.0,"end":162.66,"matched":true},{"text":"label","start":162.66,"end":162.9,"matched":true},{"text":"its","start":162.9,"end":163.2,"matched":true},{"text":"needed","start":163.2,"end":163.46,"matched":true},{"text":"lengths.","start":163.46,"end":163.74,"matched":true},{"text":"Check","start":164.6,"end":164.62,"matched":true},{"text":"the","start":164.62,"end":164.8,"matched":true},{"text":"intersection","start":164.8,"end":165.0,"matched":true},{"text":"of","start":165.0,"end":165.58,"matched":true},{"text":"any","start":165.58,"end":165.76,"matched":true},{"text":"parts","start":165.76,"end":166.14,"matched":true},{"text":"you","start":166.14,"end":166.38,"matched":true},{"text":"counted","start":166.38,"end":166.56,"matched":true},{"text":"separately.","start":166.56,"end":167.0,"matched":true},{"text":"Add","start":167.88,"end":167.94,"matched":true},{"text":"a","start":167.94,"end":168.02,"matched":true},{"text":"second","start":168.02,"end":168.34,"matched":true},{"text":"calculation","start":168.34,"end":168.76,"matched":true},{"text":"if","start":168.76,"end":169.34,"matched":true},{"text":"a","start":169.34,"end":169.42,"matched":true},{"text":"different","start":169.42,"end":169.66,"matched":true},{"text":"split","start":169.66,"end":169.98,"matched":true},{"text":"is","start":169.98,"end":170.28,"matched":true},{"text":"easy.","start":170.28,"end":170.6,"matched":true}],"match":100.0}],"captions":[{"start":0.0,"end":3.75,"text":"An area measures how many square units fill a region."},{"start":4.32,"end":7.08,"text":"Draw an extra line to split a complicated shape into"},{"start":7.08,"end":8.99,"text":"pieces whose areas you can find."},{"start":9.78,"end":12.28,"text":"If the missing pieces are simpler, start with a whole"},{"start":12.28,"end":13.87,"text":"rectangle and subtract them."},{"start":14.32,"end":16.13,"text":"Check whether those missing parts overlap."},{"start":17.24,"end":20.36,"text":"AMC practice may shade the part left after one"},{"start":20.36,"end":21.09,"text":"or more cuts."},{"start":21.92,"end":23.22,"text":"Compare the shaded region with an"},{"start":23.22,"end":24.59,"text":"easy surrounding shape."},{"start":25.22,"end":28.34,"text":"A Rossmoyne style area problem may make regions overlap."},{"start":28.34,"end":31.28,"text":"Count a shared piece exactly once when"},{"start":31.28,"end":32.59,"text":"subtracting or adding."},{"start":33.56,"end":36.6,"text":"Join a six by five rectangle to a three by four"},{"start":36.6,"end":38.89,"text":"rectangle along an edge without overlap."},{"start":39.68,"end":40.99,"text":"Find their combined area."},{"start":41.56,"end":44.81,"text":"A shared edge has length but contributes no extra area."},{"start":48.57,"end":51.38,"text":"The first area is thirty and the second is twelve."},{"start":52.07,"end":54.22,"text":"No unit square belongs to both interiors."},{"start":54.73,"end":57.1,"text":"The areas add to forty-two square units."},{"start":57.79,"end":60.36,"text":"Joining along an edge leaves this total unchanged."},{"start":61.37,"end":64.21,"text":"A eleven by nine rectangle has a right triangle removed"},{"start":64.21,"end":65.22,"text":"from one corner."},{"start":65.73,"end":67.79,"text":"The perpendicular legs of the triangle are five"},{"start":67.79,"end":68.66,"text":"and four units."},{"start":69.59,"end":72.16,"text":"Find the area left after that corner is removed."},{"start":76.06,"end":78.29,"text":"The whole rectangle has area ninety-nine."},{"start":79.12,"end":81.62,"text":"The right triangle is half of a rectangle with sides"},{"start":81.62,"end":82.83,"text":"five and four."},{"start":83.4,"end":84.18,"text":"Subtract the triangle."},{"start":84.18,"end":86.47,"text":"That leaves eighty-nine square units."},{"start":87.43,"end":90.67,"text":"On a ten by nine board, shade a lower-left rectangle"},{"start":90.67,"end":93.32,"text":"seven columns wide and six rows high."},{"start":93.97,"end":96.95,"text":"Shade the rectangle covering all columns from the fourth"},{"start":96.95,"end":98.97,"text":"onwards and rows from the third upwards,"},{"start":98.97,"end":101.2,"text":"with rows numbered from the bottom."},{"start":101.77,"end":103.44,"text":"How much area is unshaded?"},{"start":107.24,"end":109.32,"text":"The two shaded areas separately are"},{"start":109.32,"end":110.67,"text":"forty-two and forty-nine."},{"start":111.44,"end":114.09,"text":"Adding them directly would count the shared part twice."},{"start":114.82,"end":117.13,"text":"The overlap has width four and height four."},{"start":117.64,"end":119.05,"text":"Its area is sixteen."},{"start":119.74,"end":122.25,"text":"Subtract the total shaded area from the full board."},{"start":122.74,"end":125.14,"text":"The overlap correction makes the unshaded area"},{"start":125.14,"end":126.57,"text":"fifteen square units."},{"start":127.72,"end":130.84,"text":"Check by counting the unshaded bottom right block and"},{"start":130.84,"end":132.71,"text":"the unshaded top left block."},{"start":133.08,"end":135.07,"text":"Their areas are six and nine."},{"start":135.58,"end":138.66,"text":"Those two unshaded blocks have disjoint interiors."},{"start":138.66,"end":142.49,"text":"Their sum confirms the calculation using the overlap."},{"start":143.56,"end":145.39,"text":"Area uses square units."},{"start":146.0,"end":148.36,"text":"Follow the interior and do not substitute the length"},{"start":148.36,"end":150.13,"text":"around the edge for the covered region."},{"start":150.74,"end":152.79,"text":"When subtracting both shaded rectangles,"},{"start":152.98,"end":155.09,"text":"one subtraction removes the overlap again."},{"start":155.62,"end":157.13,"text":"Add that common area back once."},{"start":158.12,"end":159.81,"text":"Draw the full surrounding shape."},{"start":160.24,"end":162.0,"text":"Name each piece you add or subtract,"},{"start":162.0,"end":163.87,"text":"and label its needed lengths."},{"start":164.6,"end":166.14,"text":"Check the intersection of any parts"},{"start":166.14,"end":167.13,"text":"you counted separately."},{"start":167.88,"end":170.73,"text":"Add a second calculation if a different split is easy."}]}
