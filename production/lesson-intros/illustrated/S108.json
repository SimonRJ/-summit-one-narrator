.54,"end":157.78,"matched":true},{"text":"exposed","start":157.78,"end":158.1,"matched":true},{"text":"edges","start":158.1,"end":158.44,"matched":true},{"text":"with","start":158.44,"end":158.76,"matched":true},{"text":"different","start":158.76,"end":159.06,"matched":true},{"text":"colours.","start":159.06,"end":159.34,"matched":true},{"text":"The","start":160.08,"end":160.1,"matched":true},{"text":"units","start":160.1,"end":160.32,"matched":true},{"text":"for","start":160.32,"end":160.58,"matched":true},{"text":"perimeter","start":160.58,"end":160.84,"matched":true},{"text":"are","start":160.84,"end":161.28,"matched":true},{"text":"units","start":161.28,"end":161.54,"matched":true},{"text":"of","start":161.54,"end":161.78,"matched":true},{"text":"length.","start":161.78,"end":162.0,"matched":true},{"text":"For","start":162.72,"end":162.76,"matched":true},{"text":"a","start":162.76,"end":162.88,"matched":true},{"text":"change","start":162.88,"end":163.1,"matched":true},{"text":"of","start":163.1,"end":163.34,"matched":true},{"text":"shape,","start":163.34,"end":163.62,"matched":true},{"text":"list","start":163.92,"end":164.08,"matched":true},{"text":"which","start":164.08,"end":164.34,"matched":true},{"text":"old","start":164.34,"end":164.58,"matched":true},{"text":"edges","start":164.58,"end":164.92,"matched":true},{"text":"disappear","start":164.92,"end":165.34,"matched":true},{"text":"and","start":165.34,"end":166.04,"matched":true},{"text":"which","start":166.04,"end":166.18,"matched":true},{"text":"new","start":166.18,"end":166.42,"matched":true},{"text":"ones","start":166.42,"end":166.68,"matched":true},{"text":"appear","start":166.68,"end":166.96,"matched":true},{"text":"before","start":166.96,"end":167.36,"matched":true},{"text":"re-counting","start":167.36,"end":168.06,"matched":false},{"text":"everything.","start":168.06,"end":168.34,"matched":true}],"match":95.65}],"captions":[{"start":0.78,"end":3.17,"text":"Perimeter is the total length of the boundary."},{"start":3.74,"end":6.8,"text":"When two pieces share an edge, that edge no longer lies"},{"start":6.8,"end":7.45,"text":"on the outside."},{"start":7.98,"end":9.51,"text":"A cut can create a new boundary."},{"start":10.22,"end":12.26,"text":"Follow the edge of any hole if the question says"},{"start":12.26,"end":13.11,"text":"to include it."},{"start":13.88,"end":17.48,"text":"In AMC practice, a stepped outline or connected unit"},{"start":17.48,"end":19.81,"text":"squares can hide which edges should be counted."},{"start":20.46,"end":21.35,"text":"Mark shared edges."},{"start":21.92,"end":24.61,"text":"A Rossmoyne style question may make several cuts."},{"start":25.54,"end":28.39,"text":"Compute how each cut changes the boundary length."},{"start":29.24,"end":32.41,"text":"A rectangle is twelve metres wide and nine metres tall."},{"start":32.98,"end":33.67,"text":"What is its perimeter?"},{"start":34.48,"end":36.98,"text":"Trace around the outside to see how many of each side"},{"start":36.98,"end":37.83,"text":"length there are."},{"start":41.38,"end":43.94,"text":"There are two sides of length twelve and two"},{"start":43.94,"end":44.85,"text":"of length nine."},{"start":45.26,"end":46.09,"text":"Add all four."},{"start":46.48,"end":48.29,"text":"The perimeter is forty-two metres."},{"start":48.96,"end":51.76,"text":"Length uses metres, even though the shape also"},{"start":51.76,"end":52.65,"text":"has an area."},{"start":53.54,"end":56.29,"text":"Draw six unit squares in a horizontal row."},{"start":56.92,"end":59.3,"text":"Add two more unit squares stacked directly above"},{"start":59.3,"end":60.51,"text":"its leftmost square."},{"start":61.12,"end":62.75,"text":"What is the perimeter of this shape?"},{"start":63.32,"end":65.55,"text":"Count the contacts between pairs of squares."},{"start":69.51,"end":72.37,"text":"Taken separately, the eight squares contribute four"},{"start":72.37,"end":73.44,"text":"edge units each."},{"start":73.85,"end":75.28,"text":"There are seven shared edges."},{"start":76.07,"end":78.64,"text":"Each is counted twice in the separate square totals,"},{"start":79.15,"end":80.84,"text":"once by each square touching it."},{"start":81.25,"end":83.6,"text":"The exposed boundary length is eighteen units."},{"start":84.35,"end":87.0,"text":"Check by walking around the outside of the L shape."},{"start":87.9,"end":90.76,"text":"A square board has eight rows and eight columns"},{"start":90.76,"end":91.73,"text":"of unit squares."},{"start":92.48,"end":94.82,"text":"Cut out an interior rectangle with side lengths"},{"start":94.82,"end":95.85,"text":"four and one."},{"start":96.36,"end":98.92,"text":"Then remove one square at an outer corner far"},{"start":98.92,"end":99.63,"text":"from the hole."},{"start":100.18,"end":102.84,"text":"Find the total boundary length, including the edge"},{"start":102.84,"end":103.49,"text":"of the hole."},{"start":107.23,"end":109.52,"text":"The original outer boundary is thirty-two."},{"start":110.11,"end":113.58,"text":"Removing one corner loses two outer edges of length one"},{"start":113.67,"end":115.9,"text":"but exposes two equal inner edges."},{"start":116.61,"end":118.16,"text":"The hole adds its full perimeter,"},{"start":118.53,"end":120.04,"text":"twice four plus twice one."},{"start":120.43,"end":122.7,"text":"Every side of the hole meets the remaining board."},{"start":123.29,"end":124.24,"text":"Add that to thirty-two."},{"start":125.07,"end":127.98,"text":"The new total boundary length is forty-two units."},{"start":129.14,"end":132.26,"text":"A boundary is an edge with a filled cell on one side and"},{"start":132.26,"end":133.93,"text":"an unfilled part on the other."},{"start":134.32,"end":135.97,"text":"This includes the through-hole boundary."},{"start":136.54,"end":139.07,"text":"The outer walk and the inner walk are disjoint."},{"start":139.54,"end":142.19,"text":"Adding their lengths keeps every requested edge once."},{"start":143.22,"end":146.3,"text":"A shared edge disappears from the exterior twice when"},{"start":146.3,"end":149.11,"text":"you start by adding all individual perimeters."},{"start":149.68,"end":151.52,"text":"Cutting around a hole creates a boundary"},{"start":151.52,"end":152.63,"text":"inside the shape."},{"start":153.12,"end":156.09,"text":"Include it if the problem asks for the total boundary."},{"start":156.98,"end":159.47,"text":"Mark shared and exposed edges with different colours."},{"start":160.08,"end":162.13,"text":"The units for perimeter are units of length."},{"start":162.72,"end":165.34,"text":"For a change of shape, list which old edges disappear"},{"start":165.34,"end":168.47,"text":"and which new ones appear before re-counting everything."}]}
